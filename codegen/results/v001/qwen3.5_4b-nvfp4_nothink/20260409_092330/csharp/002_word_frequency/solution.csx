using System.IO; using System.Text.Json; using System.Linq; class Main { static void Main(string[] Args) { var lines = File.ReadAllLines(input\\text.txt); var words = string.Concat(lines).ToLower().Split(System.Text.RegexExpressions.Regex(@"[a-z]+")).Where(w => w.Length > 0); var counts = words.GroupBy(w => w).Select(g => new { Word = g.Key, Count = g.Count() }).OrderByDescending(c => c.Count).ThenBy(c => c.Word); foreach (var item in counts) Console.WriteLine($"{item.Word}: {item.Count}"); } }